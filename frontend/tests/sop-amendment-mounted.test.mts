import './mobile-dom-bootstrap.mts';
import test from 'node:test';
import assert from 'node:assert/strict';
import {dirname} from 'node:path';
import {fileURLToPath} from 'node:url';
import {createRenderer,nextTick} from '../apps/pc/node_modules/vue/index.mjs';
import {createServer} from '../apps/pc/node_modules/vite/dist/node/index.js';
type Node={parent:Node|null;children:Node[]};const make=():Node=>({parent:null,children:[]});
const renderer=createRenderer<Node,Node>({patchProp(){},insert(n,p){n.parent=p;p.children.push(n);},remove(){},createElement:make,createText:make,createComment:make,setText(){},setElementText(){},parentNode:n=>n.parent,nextSibling:()=>null,querySelector:()=>null,setScopeId(){},insertStaticContent:()=>[make(),make()]});
let server:any;
test.before(async()=>{Object.assign(globalThis.document,{getElementsByTagName:()=>[]});const configFile=fileURLToPath(new URL('../apps/pc/vite.config.ts',import.meta.url));server=await createServer({root:dirname(configFile),configFile,server:{middlewareMode:true},appType:'custom',logLevel:'silent'});});
test.after(async()=>{await server.close();});
test('failed SOP save preserves edits and does not submit stale version',async()=>{
 const {sopAmendmentApi:api}=await server.ssrLoadModule('/src/services/sopAmendmentApi.ts');
 const {default:View}=await server.ssrLoadModule('/src/views/sop/SopAmendmentView.vue');View.render=()=>null;
 const {createPinia}=await server.ssrLoadModule('pinia');
 const {useAuthStore}=await server.ssrLoadModule('/src/stores/auth.ts');
 const pinia=createPinia(),auth=useAuthStore(pinia);auth.principal={userId:'A',name:'内勤',role:'RND_ASSISTANT'};
 const snapshot={majorProcesses:[],balanceToleranceKg:0.001};
 api.get=async()=>({id:'S',formId:'F',sourceRevisionId:'R',versionNo:2,status:'DRAFT',createdById:'A',reason:'原原因',snapshot,history:[]});
 api.source=async()=>({snapshot});api.save=async()=>{throw new Error('版本冲突');};
 let submissions=0;api.submit=async()=>{submissions++;};
 const app=renderer.createApp(View,{id:'S'});app.use(pinia);app.provide(Symbol.for('v-scx'),{modules:new Set()});const instance:any=app.mount(make());
 await Promise.resolve();await nextTick();await Promise.resolve();await nextTick();
 const state=instance.$.setupState;state.reason='修改后的原因';
 await state.save();assert.equal(state.reason,'修改后的原因');assert.equal(state.error,'版本冲突');
 await state.submit();assert.equal(submissions,0);assert.equal(state.record.versionNo,2);
 app.unmount();
});
test('assistant reads formal SOP through dedicated endpoint instead of private research API',async()=>{
 const {sopAmendmentApi:api}=await server.ssrLoadModule('/src/services/sopAmendmentApi.ts');
 const {sopCatalogApi}=await server.ssrLoadModule('/src/services/sopCatalogApi.ts');
 const {api:legacy}=await server.ssrLoadModule('/src/services/api.ts');
 const {default:View}=await server.ssrLoadModule('/src/views/sop/SopCatalogView.vue');View.render=()=>null;
 const {createPinia}=await server.ssrLoadModule('pinia');const {useAuthStore}=await server.ssrLoadModule('/src/stores/auth.ts');
 const pinia=createPinia();useAuthStore(pinia).principal={userId:'A',name:'内勤',role:'RND_ASSISTANT'};
 sopCatalogApi.list=async()=>({items:[],total:0});
 legacy.task.getProcessRevision=async()=>{throw new Error('研发私有接口禁止访问');};
 api.source=async()=>({snapshot:{majorProcesses:[]}});
 const app=renderer.createApp(View);app.use(pinia);app.provide(Symbol.for('v-scx'),{modules:new Set()});const instance:any=app.mount(make());
 const state=instance.$.setupState;
 assert.equal(await state.openDetails({formId:'F',productName:'牛腩'},{id:'R',revisionNo:1}),true);
 assert.deepEqual(state.snapshot.majorProcesses,[]);app.unmount();
});
