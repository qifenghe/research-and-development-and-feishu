# 飞书真实联调环境变量模板
# 使用方式：复制为 backend/.env.feishu.local 后填写真实值。
# 注意：不要把 .env.feishu.local、App Secret、Session Secret 提交到 Git。

# 后端运行模式：MOCK=本地模拟，OPENAPI=真实飞书 OpenAPI
FEISHU_MODE=OPENAPI

# 飞书开放平台地址，通常不用改
FEISHU_BASE_URL=https://open.feishu.cn

# 飞书应用 App ID / App Secret
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书消息卡片中的业务系统访问地址
# 临时联调可使用 ngrok/cloudflared HTTPS 地址；正式环境填写公司域名
FEISHU_APP_URL=https://your-rnd-sample-domain.example.com/

# 飞书卡片按钮回调自定义校验密钥
# 需要和飞书应用后台“卡片回调”或网关转发时配置的密钥保持一致
FEISHU_CARD_ACTION_SECRET=change-me-to-a-random-secret

# 后端登录会话签名密钥，真实联调时请换成长随机字符串
SESSION_SECRET=change-me-to-a-long-random-session-secret
SESSION_TTL_SECONDS=86400

# 联调阶段如果只测飞书公开回调，可临时关闭普通接口鉴权；
# 演示完整业务流时建议保持 true，并使用飞书免登返回的 token。
SESSION_AUTH_REQUIRED=true

# 数据库连接
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rnd_sample
SPRING_DATASOURCE_USERNAME=rnd_sample
SPRING_DATASOURCE_PASSWORD=rnd_sample
