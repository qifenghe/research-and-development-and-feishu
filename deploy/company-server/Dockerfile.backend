ARG JAVA_IMAGE=m.daocloud.io/docker.io/library/eclipse-temurin:17-jre-jammy
FROM --platform=linux/amd64 ${JAVA_IMAGE}
WORKDIR /app
COPY --chown=10001:10001 app.jar /app/app.jar
USER 10001:10001
ENV TZ=Asia/Shanghai JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -Duser.timezone=Asia/Shanghai"
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
